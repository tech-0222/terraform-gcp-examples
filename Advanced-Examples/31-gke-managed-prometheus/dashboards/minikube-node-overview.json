      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.2.2"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ]
}
