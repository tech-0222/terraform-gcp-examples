project_id = "your-project-id"
region     = "asia-northeast1"
zone       = "asia-northeast1-a"

# Must match your ADC / gcloud user so you can IAP SSH to the bastion for verification.
iap_member = "user:you@example.com"

# Optional overrides:
# network_name             = "tf-adv-gke-negrec-vpc"
# gke_subnet_cidr          = "10.40.0.0/24"
# pods_cidr                = "10.41.0.0/16"
# services_cidr            = "10.42.0.0/20"
# bastion_subnet_cidr      = "10.43.0.0/24"
# master_ipv4_cidr_block   = "172.16.4.0/28"
# cluster_name             = "tf-adv-gke-negrec"
# gke_zones                = ["asia-northeast1-a", "asia-northeast1-b"]
# node_machine_type        = "e2-small"
# use_spot                 = true
# bastion_machine_type     = "e2-medium"
# neg_name                 = "tf-adv-negrec-neg"
# app_port                 = 80
#
# Leave enable_lb=false for the first apply. Set it only after deploying
# k8s/neg-app.yaml and confirming the NEGs exist (see README).
# enable_lb                = false
