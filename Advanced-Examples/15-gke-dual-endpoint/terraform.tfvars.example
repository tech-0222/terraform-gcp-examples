project_id = "your-project-id"
region     = "asia-northeast1"
zone       = "asia-northeast1-a"

# Must match your ADC / gcloud user so you can IAP SSH to the bastion for verification.
iap_member = "user:you@example.com"

# Required. Your local machine's public IP, as a /32 CIDR. Get it with:
#   curl -4 -s https://ifconfig.me
# If your IP changes (different network, VPN, ISP renewal), re-apply with
# the new value or the public endpoint will stop admitting your connection.
admin_public_cidr = "203.0.113.10/32"

# Optional overrides:
# network_name             = "tf-adv-gke-dualep-vpc"
# gke_subnet_cidr          = "10.40.0.0/24"
# pods_cidr                = "10.41.0.0/16"
# services_cidr            = "10.42.0.0/20"
# bastion_subnet_cidr      = "10.43.0.0/24"
# master_ipv4_cidr_block   = "172.16.4.0/28"
# cluster_name             = "tf-adv-gke-dualep"
# node_machine_type        = "e2-small"
# use_spot                 = true
# bastion_machine_type     = "e2-medium"
# artifact_registry_repository_id = "tf-adv-gke-dualep-repo"
