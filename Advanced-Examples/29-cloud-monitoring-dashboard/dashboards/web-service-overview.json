{
  "displayName": "Web Service Overview",
  "labels": {
    "example": "29-cloud-monitoring-dashboard"
  },
  "dashboardFilters": [
    {
      "filterType": "USER_METADATA_LABEL",
      "labelKey": "environment",
      "stringValue": "test",
      "valueType": "STRING"
    },
    {
      "filterType": "RESOURCE_LABEL",
      "labelKey": "cluster_name",
      "templateVariable": "cluster",
      "valueType": "STRING"
    },
    {
      "filterType": "RESOURCE_LABEL",
      "labelKey": "namespace_name",
      "templateVariable": "namespace",
      "valueType": "STRING"
    }
  ],
  "annotations": {
    "eventAnnotations": [
      {
        "eventType": "CLOUD_ALERTING_ALERT",
        "enabled": true
      },
      {
        "eventType": "CLOUD_RUN_DEPLOYMENT",
        "enabled": true
      },
      {
        "eventType": "GKE_WORKLOAD_DEPLOYMENT",
        "enabled": true
      },
      {
        "eventType": "GKE_POD_CRASH",
        "enabled": true
      }
    ]
  },
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Availability",
          "sectionHeader": {
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 4,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Cloud Run: requests by response code class",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"response_code_class\""
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 4,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Cloud Run: 5xx in the last 5 min",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" metric.label.\"response_code_class\"=\"5xx\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_DELTA",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "color": "RED",
                "direction": "ABOVE"
              }
            ]
          }
        }
      },
      {
        "xPos": 32,
        "yPos": 4,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Cloud Run: latency p95",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": [
                        "resource.label.\"service_name\""
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "yPos": 20,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Resources",
          "sectionHeader": {
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 24,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "GCE: CPU utilization",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 24,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "GKE: memory used by namespace",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/memory/used_bytes\" resource.type=\"k8s_container\" metric.label.\"memory_type\"=\"non-evictable\" ${cluster} ${namespace}",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"namespace_name\""
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 32,
        "yPos": 24,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "GKE: container restarts (10 min)",
          "timeSeriesTable": {
            "columnSettings": [
              {
                "column": "namespace_name",
                "visible": true
              },
              {
                "column": "pod_name",
                "visible": true
              },
              {
                "column": "value",
                "visible": true
              }
            ],
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/restart_count\" resource.type=\"k8s_container\" ${cluster} ${namespace}",
                    "aggregation": {
                      "alignmentPeriod": "600s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"namespace_name\"",
                        "resource.label.\"pod_name\""
                      ]
                    }
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      },
      {
        "yPos": 40,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Troubleshooting",
          "sectionHeader": {
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 44,
        "width": 16,
        "height": 20,
        "widget": {
          "title": "Cloud Run: latency distribution",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "HEATMAP",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 44,
        "width": 16,
        "height": 20,
        "widget": {
          "title": "ERROR logs",
          "logsPanel": {
            "filter": "severity>=ERROR\nNOT resource.labels.namespace_name=(\"kube-system\" OR \"gmp-system\")"
          }
        }
      },
      {
        "xPos": 32,
        "yPos": 44,
        "width": 16,
        "height": 20,
        "widget": {
          "title": "Incidents",
          "incidentList": {}
        }
      }
    ]
  }
}
